{
  "name": "electron-app-scaffold-for-ai-template",
  "version": "0.1.0",
  "description": "Minimal multi-brand Electron scaffold for AI apps.",
  "author": "Electron App Scaffold for AI",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.js",
  "build": {
    "appId": "com.example.electron-app-scaffold-for-ai",
    "productName": "Electron App Scaffold for AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  },
  "scripts": {
    "dev": "cross-env BRAND=$npm_config_brand electron-vite dev",
    "dev:full": "npm run dev",
    "dev:wp": "cross-env BRAND=$npm_config_brand concurrently \"npm run dev:wp:main\" \"npm run dev:wp:renderer\"",
    "dev:wp:main": "cross-env BRAND=$npm_config_brand webpack --config webpack.main.config.cjs --mode development --watch",
    "dev:wp:renderer": "cross-env BRAND=$npm_config_brand webpack --config webpack.renderer.config.cjs --mode development --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "cross-env BRAND=$npm_config_brand npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "cross-env BRAND=$npm_config_brand webpack --config webpack.main.config.cjs --mode production",
    "build:preload": "cross-env BRAND=$npm_config_brand webpack --config webpack.preload.config.cjs --mode production",
    "build:renderer": "cross-env BRAND=$npm_config_brand webpack --config webpack.renderer.config.cjs --mode production",
    "build:vite": "cross-env BRAND=$npm_config_brand electron-vite build",
    "check:impact": "node scripts/check-impact.cjs",
    "pack": "cross-env BRAND=$npm_config_brand electron-builder --config electron-builder.config.cjs --dir",
    "dist": "cross-env BRAND=$npm_config_brand electron-builder --config electron-builder.config.cjs",
    "dist:publish": "cross-env BRAND=$npm_config_brand electron-builder --config electron-builder.config.cjs --publish always",
    "check:file-length": "node scripts/check-file-length.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "preview": "electron-vite preview",
    "prepare:release": "node scripts/prepare-release.mjs",
    "prepare:release:patch": "node scripts/prepare-release.mjs patch",
    "prepare:release:minor": "node scripts/prepare-release.mjs minor",
    "prepare:release:major": "node scripts/prepare-release.mjs major"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@swc/core": "^1.11.24",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "html-webpack-plugin": "^5.6.0",
    "typescript": "^5.8.3",
    "ts-loader": "^9.5.1",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}
